:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#191919;background:#f4f4f1;--border:#deded8;--muted:#6e6e68;--soft:#f7f7f4;--ink:#171717;--sidebar:248px}*{box-sizing:border-box}body{margin:0;min-width:320px}.app-shell{min-height:100vh;display:grid;grid-template-columns:var(--sidebar) 1fr}.sidebar{position:sticky;top:0;height:100vh;padding:24px 16px;background:#efefeb;border-right:1px solid #dcdcd6;display:flex;flex-direction:column}.brand{display:flex;gap:10px;align-items:center;padding:0 8px 24px}.brand-mark{width:34px;height:34px;border-radius:10px;background:#171717;color:white;display:grid;place-items:center;font-size:12px;font-weight:800}.brand strong,.brand span{display:block}.brand>div>span{font-size:12px;color:var(--muted);margin-top:1px}.nav{display:grid;gap:4px}.nav-item{border:0;background:transparent;text-align:left;padding:11px 12px;border-radius:9px;font:inherit;font-weight:650;color:#444;cursor:pointer}.nav-item span{display:inline-block;width:22px;color:#777}.nav-item:hover{background:#e5e5e0}.nav-item.active{background:#fff;color:#111;box-shadow:0 1px 2px rgba(0,0,0,.04)}.sidebar-foot{margin-top:auto;padding:14px 8px 0;border-top:1px solid #d7d7d1;font-size:11px;color:var(--muted);display:flex;gap:7px;align-items:center}.dot{width:7px;height:7px;border-radius:50%;background:#5b8c56}.main{min-width:0}.view{display:none;padding:44px clamp(28px,3.6vw,72px) 72px}.view.active{display:block}.page-head{max-width:1560px;margin:0 auto 28px;display:flex;justify-content:space-between;align-items:flex-end;gap:24px}.page-head.compact{align-items:center}.page-head h1{font-size:34px;letter-spacing:-.035em;margin:4px 0 8px}.page-head p{margin:0;color:var(--muted);max-width:680px;line-height:1.55}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.11em;font-weight:800;color:#70706b}.head-actions{display:flex;align-items:center;gap:8px}.save-state{font-size:12px;color:var(--muted);margin-right:4px}.back-link{border:0;padding:0 0 10px;background:none;color:var(--muted);font:inherit;cursor:pointer}.library{max-width:1560px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}.empty{grid-column:1/-1;border:1px dashed #d1d1ca;background:#fafaf8;border-radius:16px;padding:56px;text-align:center}.empty h2{margin:0 0 7px}.empty p{color:var(--muted);margin:0 0 18px}.flavour-card{border:1px solid var(--border);background:white;border-radius:15px;padding:18px;display:flex;min-height:190px;flex-direction:column;cursor:pointer;transition:.14s ease}.flavour-card:hover{transform:translateY(-1px);box-shadow:0 8px 28px rgba(0,0,0,.06)}.flavour-card h3{margin:0;font-size:18px}.flavour-card .slug{font-size:11px;color:#888;margin-top:4px}.flavour-card p{font-size:13px;line-height:1.5;color:var(--muted);margin:15px 0}.flavour-meta{margin-top:auto;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--muted)}.foundation-chips{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.chip{font-size:10px;padding:4px 7px;border-radius:999px;background:#f0f0ec;color:#555}.builder-layout{max-width:1560px;margin:0 auto;display:grid;grid-template-columns:220px minmax(620px,1fr) 380px;gap:22px;align-items:start}.steps{position:sticky;top:24px;display:grid;gap:6px}.step{border:1px solid transparent;background:transparent;text-align:left;padding:12px 13px;border-radius:11px;color:#6b6b66;font:inherit;cursor:pointer;display:grid;grid-template-columns:30px 1fr auto;align-items:start;gap:0}.step:hover{background:#ecece7}.step.active{background:#fff;color:#111;border-color:var(--border);box-shadow:0 2px 8px rgba(0,0,0,.045)}.step-num{font-size:10px;color:#96968f;padding-top:2px}.step strong{font-size:14px}.step small{display:block;font-size:11px;font-weight:500;color:#8a8a84;margin-top:3px}.step-mark{font-size:11px;font-weight:800;color:#777;padding-top:1px}.step.has-overrides .step-mark{color:#222}.step.is-complete:not(.active){color:#444}.step-content,.assistant{background:white;border:1px solid var(--border);border-radius:18px;min-height:620px}.step-content{padding:32px 34px 24px;display:flex;flex-direction:column}.step-head{display:flex;justify-content:space-between;gap:24px;margin-bottom:30px}.step-head>div{max-width:760px}.step-head h2{font-size:28px;margin:3px 0 6px;letter-spacing:-.025em}.step-head p{margin:0;color:var(--muted);line-height:1.6;font-size:14px}.step-status{font-size:11px;padding:6px 9px;border-radius:999px;background:#f0f0ec;height:max-content}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:700}.field .help{font-size:11px;color:#888}.field input,.field textarea,.field select{width:100%;border:1px solid #d6d6d0;border-radius:9px;background:white;padding:11px 12px;font:inherit}.field textarea{resize:vertical;min-height:100px}.id-preview{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;background:#f5f5f1;padding:10px 12px;border-radius:8px}.decision-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.decision-card{border:1px solid #e1e1dc;border-radius:12px;padding:15px;background:#fafaf8}.decision-card h3{font-size:14px;margin:0 0 6px;text-transform:capitalize}.decision-card p{font-size:12px;color:var(--muted);margin:0 0 12px}.decision-card footer{display:flex;justify-content:space-between;font-size:11px;color:#888}.coming{padding:16px;border-radius:11px;background:#f3f3ef;color:#666;font-size:12px;margin-top:18px}.assistant{position:sticky;top:24px;display:flex;flex-direction:column;overflow:hidden;max-height:calc(100vh - 48px)}.assistant-head{display:flex;justify-content:space-between;align-items:center;padding:16px 17px;border-bottom:1px solid #ecece7}.assistant-kicker{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#8d8d87;font-weight:800;margin-bottom:2px}.assistant-context{padding:9px 17px;background:#f7f7f4;border-bottom:1px solid #ecece7;font-size:10px;color:#777}.assistant-body{padding:18px;flex:1;overflow:auto}.assistant-message{background:#f3f3ef;border-radius:11px;padding:13px;font-size:12px;line-height:1.5}.assistant-message p{margin:5px 0 0;color:#666}.assistant-compose{border-top:1px solid #ecece7;padding:12px;display:grid;grid-template-columns:1fr auto;gap:7px}.assistant-compose textarea{min-height:54px;resize:none;border:1px solid #deded7;border-radius:8px;padding:9px;font:inherit;font-size:12px}.assistant-compose button{padding:8px 10px}.assistant-compose span{grid-column:1/-1;color:#999;font-size:9px}.assistant-fab{position:fixed;right:22px;bottom:22px;border:0;background:#171717;color:white;width:46px;height:46px;border-radius:50%;font-weight:800}.catalogue-grid{max-width:1560px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}.catalogue-card{background:white;border:1px solid var(--border);border-radius:14px;padding:17px}.catalogue-card h3{text-transform:capitalize;margin:0 0 5px}.catalogue-card .count{font-size:28px;font-weight:750}.catalogue-card p{font-size:11px;color:#777}.pill{padding:8px 12px;border-radius:999px;background:white;border:1px solid var(--border);font-size:12px}.sync-grid{max-width:1560px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:16px}.card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:18px}.card h2{font-size:15px;margin:0 0 14px}.repo{padding:12px 0;border-top:1px solid #ededE8;display:grid;grid-template-columns:130px 1fr auto;gap:12px;align-items:center}.repo:first-of-type{border-top:0}.repo-name{font-weight:650}.meta{font-size:12px;color:#666}.dirty{font-size:11px;padding:4px 8px;border-radius:999px;background:#fff3cf}.clean{font-size:11px;color:#5e665c}.controls{display:grid;gap:10px}.button-row{display:flex;gap:8px}.button-row>*{flex:1}.controls label{display:flex;align-items:center;gap:8px}.controls select,.commit select,.commit input{flex:1}.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.metric{padding:13px;border-radius:10px;background:#f6f6f3}.metric b{display:block;font-size:22px}.metric span{font-size:11px;color:#666}.resolved{padding:13px;background:#f6f6f3;border-radius:10px;margin:10px 0 14px}.changes{max-width:1560px;margin:16px auto 0}.commit{display:grid;grid-template-columns:160px 1fr auto;gap:8px;margin-top:10px}.log{font-family:ui-monospace,Consolas,monospace;font-size:11px;white-space:pre-wrap;background:#171717;color:#eee;border-radius:10px;padding:13px;min-height:110px;max-height:300px;overflow:auto}button,select,input,textarea{font:inherit}button{border:1px solid #d7d7d0;border-radius:9px;padding:10px 13px;background:#fff;cursor:pointer;font-weight:650}.primary{background:#171717;color:#fff;border-color:#171717}.secondary{background:#fff}.danger{color:#a32b2b;background:#fff}.icon-btn{border:0;background:transparent;padding:4px 7px;font-size:20px;color:#777}.hidden{display:none!important}button:disabled{opacity:.45;cursor:not-allowed}@media(max-width:1280px){.builder-layout{grid-template-columns:190px minmax(0,1fr)}.assistant{display:none}.assistant-fab{display:block!important}}@media(max-width:850px){:root{--sidebar:76px}.brand>div,.nav-item:not(.active){font-size:0}.nav-item{padding:12px;text-align:center}.nav-item span{width:auto;font-size:18px}.nav-item.active{font-size:0}.sidebar-foot span:last-child{display:none}.page-head{align-items:flex-start;flex-direction:column}.builder-layout{grid-template-columns:1fr}.steps{position:static;display:flex;overflow:auto}.step{min-width:115px}.step-content{min-height:unset}.sync-grid{grid-template-columns:1fr}.form-grid,.decision-grid{grid-template-columns:1fr}.field.full{grid-column:auto}}@media(max-width:560px){:root{--sidebar:0px}.sidebar{display:none}.view{padding:24px 16px}.page-head h1{font-size:28px}.head-actions{flex-wrap:wrap}.commit{grid-template-columns:1fr}}
/* Flavour authoring editors */
.editor-toolbar{display:flex;justify-content:space-between;gap:18px;align-items:center;margin:0 0 18px;padding:12px 14px;border:1px solid #e6e6e0;background:#fafaf8;border-radius:11px}.editor-toolbar>div{display:grid;gap:2px}.editor-toolbar strong{font-size:13px}.editor-toolbar span{font-size:10px;color:var(--muted)}.colour-sections,.type-groups{display:grid;gap:16px}.token-section{border:1px solid #e4e4df;border-radius:13px;overflow:hidden}.token-section-head{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:#f7f7f4;border-bottom:1px solid #e7e7e2}.token-section-head h3{margin:0;font-size:13px}.token-section-head span{font-size:10px;color:#888}.colour-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:0}.colour-token{display:grid;grid-template-columns:38px minmax(0,1fr) 28px;gap:10px;align-items:center;padding:11px 12px;border-right:1px solid #efefeb;border-bottom:1px solid #efefeb;min-width:0}.colour-token.custom,.type-token.custom{background:#fbfbf7}.swatch-wrap{width:34px;height:34px;position:relative;border-radius:9px;overflow:hidden;background:repeating-conic-gradient(#eee 0 25%,#fff 0 50%) 0/10px 10px;border:1px solid #ddd}.swatch{position:absolute;inset:0}.colour-picker{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}.token-main{min-width:0}.token-main label,.type-token label{display:block;font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.token-main code,.type-token code{display:block;font-size:8.5px;color:#999;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:2px 0 6px}.token-value{width:100%;border:1px solid #deded8;border-radius:7px;padding:7px 8px;font:inherit;font-size:11px;background:#fff}.token-reset{border:0;background:transparent;padding:6px;color:#999}.token-reset:hover{color:#111}.type-specimen{padding:26px;border-radius:14px;background:#f5f5f1;margin-bottom:18px;overflow:hidden;--specimen-family:inherit;--specimen-secondary:inherit;--specimen-weight:700}.specimen-display{font-family:var(--specimen-family);font-size:clamp(28px,4vw,54px);font-weight:var(--specimen-weight);letter-spacing:-.045em;line-height:1.02;max-width:780px}.specimen-heading{font-family:var(--specimen-family);font-size:22px;font-weight:650;margin:18px 0 6px}.type-specimen p{font-family:var(--specimen-secondary);font-size:15px;line-height:1.6;max-width:700px;margin:0 0 14px;color:#555}.type-specimen>span{font-family:var(--specimen-secondary);font-size:10px;letter-spacing:.09em;font-weight:700}.type-token-grid{display:grid}.type-token{display:grid;grid-template-columns:minmax(180px,1.2fr) minmax(150px,1fr) 28px;gap:12px;align-items:center;padding:10px 12px;border-bottom:1px solid #efefeb}.type-token:last-child{border-bottom:0}.assistant-model{grid-column:1/-1;display:grid;grid-template-columns:1fr auto;gap:6px}.assistant-model select{min-width:0;border:1px solid #deded7;border-radius:8px;padding:7px 8px;background:white;font-size:10px}.assistant-model .ghost{padding:6px 9px}.assistant-reply{font-size:11px;line-height:1.5;color:#555;margin:10px 0}.proposal-list{display:grid;gap:7px}.proposal{display:grid;grid-template-columns:auto 1fr;gap:8px;padding:9px;border:1px solid #e5e5df;border-radius:9px;background:#fafaf8;font-size:10px}.proposal>span{min-width:0}.proposal code{display:block;color:#777;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.proposal b{display:block;margin:3px 0}.proposal small{display:block;color:#888;line-height:1.35}.proposal-apply{width:100%;margin-top:9px;font-size:10px;padding:8px}.assistant-body{overflow:auto;max-height:500px}.assistant-compose{grid-template-columns:1fr auto}.assistant-compose .assistant-model{grid-column:1/-1}
@media(max-width:720px){.colour-grid{grid-template-columns:1fr}.type-token{grid-template-columns:1fr 28px}.type-token>.token-value{grid-column:1/2}.editor-toolbar{align-items:flex-start;flex-direction:column}}

/* Wizard journey refinement */
.step-journey{margin-top:auto;padding-top:28px;border-top:1px solid #ecece7;display:flex;align-items:center;justify-content:space-between;gap:14px}.journey-side{display:flex;align-items:center;gap:9px}.journey-meta{font-size:11px;color:var(--muted)}.journey-next{min-width:158px}.journey-prev{min-width:112px}.step-status.modified{background:#ecece7;color:#333}.step-status.inherited{background:#f6f6f3;color:#777}.step-status.ready{background:#edf4eb;color:#486044}.builder-layout .assistant-compose{background:#fff}.assistant-head strong{font-size:14px}.assistant-context{font-size:11px;padding:10px 18px}.assistant-compose textarea{min-height:68px}.builder-layout.compact-ai{grid-template-columns:220px minmax(620px,1fr)}
@media(max-width:1280px){.step-journey{position:sticky;bottom:0;background:#fff;padding-bottom:8px}}

/* Flavour wizard: Shape, Spacing & Scale, Depth and Motion */
.design-preview{display:grid;grid-template-columns:minmax(260px,.9fr) minmax(320px,1.1fr);gap:24px;align-items:center;padding:22px;border:1px solid #e5e5df;border-radius:14px;background:#f7f7f4;margin-bottom:18px;overflow:hidden}.preview-copy{display:grid;gap:6px}.preview-copy>span{font-size:9px;text-transform:uppercase;letter-spacing:.11em;color:#888;font-weight:800}.preview-copy>strong{font-size:20px;line-height:1.15}.preview-copy p{font-size:11px;line-height:1.5;color:#70706a;margin:0;max-width:480px}.shape-demo{display:flex;align-items:end;justify-content:center;gap:18px;min-height:120px}.shape-card,.shape-control,.shape-pill{background:#fff;border:2px solid #222;box-shadow:0 10px 24px rgba(0,0,0,.06)}.shape-card{width:110px;height:92px;border-radius:18px}.shape-control{width:128px;height:42px;border-radius:9px}.shape-pill{width:92px;height:34px;border-radius:999px}.scale-demo{display:flex;align-items:end;justify-content:center;gap:9px;height:130px;padding:18px}.scale-demo i{display:block;background:#202020;border-radius:7px;width:28px}.scale-demo i:nth-child(1){height:28px}.scale-demo i:nth-child(2){height:44px}.scale-demo i:nth-child(3){height:64px}.scale-demo i:nth-child(4){height:88px}.scale-demo i:nth-child(5){height:110px}.depth-demo{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:14px}.depth-demo div{height:94px;border-radius:14px;background:#fff;display:grid;place-items:center;font-size:10px;color:#777}.depth-demo div:nth-child(1){box-shadow:0 4px 12px rgba(0,0,0,.08)}.depth-demo div:nth-child(2){box-shadow:0 10px 24px rgba(0,0,0,.12)}.depth-demo div:nth-child(3){box-shadow:0 18px 40px rgba(0,0,0,.18)}.motion-demo{justify-self:center;position:relative;width:230px;height:78px;overflow:hidden;background:#fff;border:1px solid #ddd}.motion-demo span{position:absolute;left:14px;top:17px;width:42px;height:42px;border-radius:12px;background:#171717}.motion-demo.playing span{animation:bc-motion-preview .72s cubic-bezier(.2,.8,.2,1)}@keyframes bc-motion-preview{0%{transform:translateX(0) rotate(0)}55%{transform:translateX(145px) rotate(10deg)}100%{transform:translateX(0) rotate(0)}}.foundation-editor{margin-bottom:18px}.foundation-toolbar:not(:first-of-type){margin-top:22px}.foundation-token label{text-transform:none}.foundation-token .token-value{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:10px}@media(max-width:820px){.design-preview{grid-template-columns:1fr}.shape-demo,.scale-demo{min-height:96px}.depth-demo{padding:4px}.motion-demo{width:min(100%,260px)}}

.review-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:18px 0}.review-stat{border:1px solid var(--line,#deddd8);border-radius:14px;padding:16px;background:#f7f6f2;display:grid;gap:4px}.review-stat b{font-size:22px}.review-stat span{font-size:12px;color:#6c6a63}.completion-panel{margin-top:18px;border:1px solid var(--line,#deddd8);border-radius:16px;padding:18px;display:grid;gap:16px}.completion-panel h3{margin:4px 0 6px}.completion-panel p{margin:0;color:#6c6a63;max-width:760px}.completion-actions{display:flex;gap:10px;flex-wrap:wrap}.review-output{margin:0;min-height:88px;white-space:pre-wrap;background:#171716;color:#f5f4ef;border-radius:12px;padding:14px;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace}.completion-actions button{min-width:150px}@media(max-width:900px){.review-summary{grid-template-columns:1fr}.completion-actions{display:grid}.completion-actions button{width:100%}}

/* Persistent Flavour assistant conversation */
#aiConversation{display:grid;gap:10px}
.assistant-turn{padding:10px 12px;border:1px solid var(--line,#e7e5e1);border-radius:10px;background:#fff}
.assistant-turn.user{background:#f5f4f1}
.assistant-turn span{display:block;margin-bottom:4px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#77736d}
.assistant-turn p{margin:0;line-height:1.45;white-space:pre-wrap}

/* Guided Colour Engine */
.colour-workbench{display:grid;gap:12px;margin-bottom:16px}.colour-overview{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:24px;align-items:center;padding:20px;border:1px solid #e3e2dc;border-radius:14px;background:#f7f7f3}.colour-overview h3{font-size:20px;line-height:1.15;margin:4px 0 7px;max-width:650px}.colour-overview p{font-size:11px;line-height:1.55;color:#6d6c66;margin:0;max-width:670px}.colour-overview-meta{display:grid;justify-items:end;gap:3px}.colour-overview-meta>strong{font-size:28px}.colour-overview-meta>span:not(.palette-strip):not(.palette-empty){font-size:10px;color:#85837c}.colour-actions{display:flex;justify-content:flex-end;gap:8px}.palette-strip{display:flex;width:100%;height:18px;border-radius:6px;overflow:hidden;border:1px solid #deddd7;margin-top:7px;background:#fff}.palette-strip i{flex:1;min-width:2px}.palette-empty{font-size:9px;color:#999;margin-top:7px}.colour-sections.guided{gap:10px}.colour-decision{border:1px solid #e4e3dd;border-radius:13px;background:#fff;overflow:hidden}.colour-decision>summary{list-style:none;display:grid;grid-template-columns:34px minmax(220px,1fr) auto 150px 18px;gap:12px;align-items:center;padding:14px 16px;cursor:pointer}.colour-decision>summary::-webkit-details-marker{display:none}.decision-index{font:700 10px/1 ui-monospace,SFMono-Regular,Consolas,monospace;color:#9a9891}.decision-summary{display:grid;gap:2px}.decision-summary strong{font-size:13px}.decision-summary small{font-size:10px;line-height:1.35;color:#77746e}.decision-progress{font-size:10px;font-weight:700;color:#65635e;background:#f3f2ee;border-radius:999px;padding:5px 8px}.colour-decision>summary .palette-strip{width:150px;margin:0}.colour-decision>summary .palette-empty{margin:0;text-align:right}.decision-chevron{font-size:16px;color:#999;transition:transform .18s}.colour-decision[open] .decision-chevron{transform:rotate(180deg)}.colour-decision-body{border-top:1px solid #ecebe6}.colour-decision-tools{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:#fafaf8;border-bottom:1px solid #ecebe6}.colour-decision-tools>span{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:#8a8881;font-weight:800}.colour-ai-action{font-size:9px;padding:6px 9px}.colour-decision .colour-grid{background:#fff}@media(max-width:920px){.colour-overview{grid-template-columns:1fr}.colour-overview-meta{justify-items:start}.colour-decision>summary{grid-template-columns:30px 1fr auto 18px}.colour-decision>summary .palette-strip,.colour-decision>summary .palette-empty{display:none}}@media(max-width:620px){.colour-actions{display:grid}.colour-decision>summary{padding:12px}.decision-summary small{display:none}.colour-decision-tools{align-items:flex-start;gap:8px;flex-direction:column}}

/* Guided Colour mini-wizard */
.colour-guided-shell{display:grid;gap:14px}.colour-mini-nav{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border:1px solid #e4e3dd;border-radius:14px;overflow:hidden;background:#f7f7f3}.colour-mini-step{border:0;border-right:1px solid #e6e5df;background:transparent;padding:12px 13px;text-align:left;display:grid;gap:2px;min-width:0}.colour-mini-step:last-child{border-right:0}.colour-mini-step>span{font:700 9px ui-monospace,SFMono-Regular,Consolas,monospace;color:#aaa79e}.colour-mini-step strong{font-size:11px}.colour-mini-step small{font-size:8.5px;color:#8a8881}.colour-mini-step.active{background:#fff;box-shadow:inset 0 -2px 0 #111}.colour-mini-step.complete small{color:#46734d}.colour-stage{border:1px solid #e3e2dc;border-radius:15px;background:#fff;overflow:hidden}.colour-stage-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;padding:20px;border-bottom:1px solid #ecebe6;background:#fafaf7}.colour-stage-head h3{font-size:23px;margin:4px 0 7px}.colour-stage-head p{font-size:11px;color:#6f6d66;line-height:1.55;max-width:720px;margin:0}.colour-stage-actions{display:flex;gap:8px;align-items:center}.stage-progress{font-size:10px;font-weight:800;border-radius:999px;background:#efeee9;padding:6px 9px;white-space:nowrap}.source-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;padding:16px}.colour-source-card{border:1px solid #e6e5df;border-radius:12px;overflow:hidden;background:#fff}.colour-source-card.ready{border-color:#cfcec6}.source-card-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;padding:12px 13px;border-bottom:1px solid #efeee9}.source-card-head>div{display:grid;gap:2px}.source-card-head span{font-size:11px;font-weight:800}.source-card-head small{font-size:9px;color:#85837b;line-height:1.35}.source-state{font-size:8px!important;text-transform:uppercase;letter-spacing:.08em;color:#98968f}.ready .source-state{color:#46734d}.source-input{display:grid;grid-template-columns:36px minmax(0,1fr) auto;gap:8px;padding:11px 12px;align-items:center}.source-swatch{width:34px;height:34px;border-radius:9px;border:1px solid #d8d7d0;background:repeating-conic-gradient(#eee 0 25%,#fff 0 50%) 0/10px 10px;overflow:hidden;cursor:pointer}.source-swatch input{opacity:0;width:100%;height:100%;cursor:pointer}.source-hex{min-width:0;border:1px solid #deddd7;border-radius:8px;padding:8px;font:600 10px ui-monospace,SFMono-Regular,Consolas,monospace}.source-reset{font-size:9px;padding:7px 9px}.generated-strip{display:flex;min-height:30px;border-top:1px solid #efeee9;background:#f7f7f4}.generated-tone{flex:1;min-width:0;text-align:center}.generated-tone i{display:block;height:20px}.generated-tone small{display:block;font-size:7px;color:#8c8981;padding:3px 1px;white-space:nowrap;overflow:hidden}.source-empty{padding:18px;font-size:10px;color:#8d8a83;text-align:center;background:#fafaf7}.ground-preview{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid #ecebe6}.ground-preview>div{min-height:110px;padding:14px;display:flex;flex-direction:column;justify-content:flex-end;background:#f4f3ef}.ground-preview span{font-size:9px;font-weight:800}.ground-preview b{font:600 9px ui-monospace,SFMono-Regular,Consolas,monospace;margin-top:2px}.neutral-builder{padding:16px;display:grid;gap:14px}.neutral-builder>.colour-source-card{max-width:520px}.neutral-scale-preview{border:1px solid #e6e5df;border-radius:12px;overflow:hidden}.neutral-scale-preview header{display:flex;justify-content:space-between;gap:20px;padding:12px 13px}.neutral-scale-preview header strong{font-size:11px}.neutral-scale-preview header span{font-size:9px;color:#85837b}.neutral-scale-preview .generated-strip{border-top:1px solid #ecebe6}.colour-stage-nav{display:flex;justify-content:space-between;gap:10px;padding:12px 16px;border-top:1px solid #ecebe6;background:#fafaf7}.colour-footer-actions{display:flex;justify-content:flex-end;gap:8px}.colour-review{display:grid;gap:14px;padding:16px}.palette-completion{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:16px 18px;border:1px solid #e6e0d4;border-radius:12px;background:#fffaf0}.palette-completion.complete{background:#f5faf4;border-color:#d8e5d6}.palette-completion h3{font-size:18px;margin:3px 0 5px}.palette-completion p{font-size:10px;color:#77746d;margin:0}.palette-completion>strong{font-size:30px}.review-palette-sections{display:grid;gap:10px}.review-palette-sections>section{border:1px solid #e5e4de;border-radius:12px;overflow:hidden}.review-palette-sections>section>header{display:flex;justify-content:space-between;padding:10px 12px;background:#f8f8f5}.review-palette-sections header strong{font-size:11px}.review-palette-sections header span{font-size:9px;color:#88857e}.review-family{display:grid;grid-template-columns:130px minmax(0,1fr);align-items:center;border-top:1px solid #efeee9}.review-family>b{font-size:9px;padding:10px 12px}.review-family .generated-strip{border:0;min-height:24px}.review-family .generated-tone i{height:24px}.semantic-preview{border:1px solid #e3e2dc;border-radius:13px;overflow:hidden}.semantic-preview>header{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:14px 16px;background:#f8f8f5}.semantic-preview h3{font-size:17px;margin:3px 0}.semantic-preview p{font-size:9px;color:#77746d;margin:0}.semantic-mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#e8e7e1}.semantic-mode{background:#fff;padding:12px}.semantic-mode>header{display:flex;justify-content:space-between;margin-bottom:8px}.semantic-mode>header strong{font-size:12px}.semantic-mode>header span{font-size:8px;color:#999}.semantic-mode details{border-top:1px solid #efeee9;padding:7px 0}.semantic-mode summary{cursor:pointer;font-size:9px;font-weight:800}.semantic-mode summary small{font-weight:500;color:#999}.semantic-swatches{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:5px;margin-top:7px}.semantic-swatches>div{border:1px solid #ecebe6;border-radius:7px;overflow:hidden;min-width:0}.semantic-swatches i{display:block;height:25px;background:#f5f5f2}.semantic-swatches span{display:block;font-size:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:4px}
@media(max-width:1000px){.colour-mini-nav{grid-template-columns:repeat(3,1fr)}.colour-mini-step:nth-child(3){border-right:0}.semantic-mode-grid{grid-template-columns:1fr}.colour-stage-head{flex-direction:column}.colour-stage-actions{width:100%;justify-content:space-between}}@media(max-width:650px){.colour-mini-nav{grid-template-columns:repeat(2,1fr)}.source-grid{grid-template-columns:1fr}.ground-preview{grid-template-columns:1fr}.review-family{grid-template-columns:1fr}.colour-stage-nav,.colour-footer-actions{display:grid}.neutral-scale-preview header{display:grid}}

/* Guided semantic colour generation */
.colour-mini-nav-nine{grid-template-columns:repeat(9,minmax(82px,1fr));overflow-x:auto}
.semantic-callout,.semantic-ai-note{display:flex;gap:12px;align-items:flex-start;justify-content:space-between;padding:14px 16px;border:1px solid var(--line,#d9dde3);border-radius:12px;background:var(--panel-soft,#f7f8fa);margin:14px 0}
.semantic-callout.warning{border-style:dashed}
.semantic-callout p,.semantic-ai-note span{margin:0;color:var(--muted,#667085);font-size:13px;line-height:1.45}
.semantic-loading{padding:28px;text-align:center;color:var(--muted,#667085)}
.semantic-generation-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:12px}
.semantic-generation-head h3{margin:4px 0 6px}.semantic-generation-head p{margin:0;max-width:760px;color:var(--muted,#667085)}
.semantic-generation-actions{display:flex;align-items:center;gap:12px;white-space:nowrap}.semantic-generation-actions>span{font-weight:700}
.semantic-group{border:1px solid var(--line,#d9dde3);border-radius:14px;overflow:hidden;margin:14px 0;background:var(--panel,#fff)}
.semantic-group>header{display:flex;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--line,#d9dde3)}
.semantic-mapping-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
.semantic-mapping{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.9fr);gap:8px 14px;padding:14px 16px;border-bottom:1px solid var(--line,#e7e9ee);align-items:center}
.semantic-mapping:nth-child(odd){border-right:1px solid var(--line,#e7e9ee)}
.semantic-mapping>span{min-width:0}.semantic-mapping b{display:block;font-size:13px}.semantic-mapping code{display:block;font-size:10px;color:var(--muted,#667085);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:3px}
.semantic-mapping select{width:100%;min-width:0}.semantic-mapping small{grid-column:2;color:var(--muted,#667085)}.semantic-mapping.fixed{background:rgba(127,127,127,.04)}
.semantic-mode-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:16px 0}.semantic-mode-summary article{border:1px solid var(--line,#d9dde3);border-radius:12px;padding:16px;display:grid;gap:4px}.semantic-mode-summary b{font-size:24px}.semantic-mode-summary small{color:var(--muted,#667085)}
@media (max-width:1200px){.semantic-mapping-list{grid-template-columns:1fr}.semantic-mapping:nth-child(odd){border-right:0}.colour-mini-nav-nine{grid-template-columns:repeat(9,110px)}}

/* Guided Typography system */
.type-guided-shell{display:grid;gap:14px}.type-mini-nav{display:grid;grid-template-columns:repeat(7,minmax(100px,1fr));border:1px solid #e4e3dd;border-radius:14px;overflow-x:auto;background:#f7f7f3}.type-mini-step{border:0;border-right:1px solid #e6e5df;background:transparent;padding:12px 13px;text-align:left;display:grid;gap:2px}.type-mini-step>span{font:700 9px ui-monospace,SFMono-Regular,Consolas,monospace;color:#aaa79e}.type-mini-step strong{font-size:11px}.type-mini-step small{font-size:8.5px;color:#8a8881}.type-mini-step.active{background:#fff;box-shadow:inset 0 -2px 0 #111}.type-mini-step.complete small{color:#46734d}.type-stage{border:1px solid #e3e2dc;border-radius:15px;background:#fff;overflow:hidden}.type-stage-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;padding:20px;border-bottom:1px solid #ecebe6;background:#fafaf7}.type-stage-head h3{font-size:23px;margin:4px 0 7px}.type-stage-head p{font-size:11px;color:#6f6d66;line-height:1.55;max-width:720px;margin:0}.type-stage-body{padding:16px}.type-stage-nav{display:flex;justify-content:space-between;padding:12px 16px;border-top:1px solid #ecebe6;background:#fafaf7}.type-guided-section{border:1px solid #e6e5df;border-radius:12px;overflow:hidden;margin-top:14px}.type-guided-section>header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;padding:14px 16px;background:#f8f8f5;border-bottom:1px solid #ecebe6}.type-guided-section h3{margin:3px 0 4px}.type-guided-section p{margin:0;font-size:10px;color:#77746d}.type-token-grid.guided{padding:12px}.type-guided-preview{margin:0}.type-material-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.type-material-meta span{font-size:8px;background:#f0efea;border-radius:999px;padding:5px 8px}.type-role-group{border:1px solid #e3e2dc;border-radius:12px;overflow:hidden;margin:12px 0}.type-role-group>header{padding:12px 14px;background:#f8f8f5;border-bottom:1px solid #ecebe6}.type-role-group>header>div{display:flex;justify-content:space-between}.type-role-group header strong{font-size:12px}.type-role-group header span{font-size:9px;color:#88857e}.type-role-levels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.type-role-levels article{padding:13px;border-bottom:1px solid #efeee9}.type-role-levels article:nth-child(odd){border-right:1px solid #efeee9}.type-role-title{margin-bottom:9px}.type-role-title b{font-size:11px}.type-role-properties{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}.type-role-properties label{display:grid;gap:4px;min-width:0}.type-role-properties span{font-size:8px;color:#77746d}.type-role-properties select{width:100%;min-width:0;font-size:9px}.type-review{display:grid;gap:14px}.type-role-builder .semantic-generation-head{margin-top:0}@media(max-width:1200px){.type-mini-nav{grid-template-columns:repeat(7,120px)}.type-role-levels{grid-template-columns:1fr}.type-role-levels article:nth-child(odd){border-right:0}.type-role-properties{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.type-stage-head{flex-direction:column}.type-role-properties{grid-template-columns:1fr}.type-stage-nav{display:grid;grid-template-columns:1fr 1fr;gap:8px}}

/* Typography baseline inheritance */
.type-role-properties label{position:relative}
.type-role-properties label em{font-style:normal;font-size:.68rem;font-weight:700;letter-spacing:.02em;margin-left:.35rem;padding:.12rem .38rem;border-radius:999px;background:var(--panel-2,#f3f4f6);color:var(--muted,#667085)}
.type-role-properties label.modified em{background:#eef2ff;color:#4338ca}
.type-property-reset,.type-role-reset{border:0;background:transparent;color:var(--muted,#667085);font:inherit;font-size:.72rem;cursor:pointer;padding:.2rem .35rem}
.type-property-reset:disabled{opacity:.32;cursor:default}
.type-role-title{display:flex;align-items:center;justify-content:space-between;gap:.75rem}

.guided-foundation-shell{display:grid;gap:14px;margin-top:14px}.guided-foundation-section{border:1px solid #e3e2dc;border-radius:14px;overflow:hidden;background:#fff}.guided-foundation-section>header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;padding:16px 18px;background:#fafaf7;border-bottom:1px solid #ecebe6}.guided-foundation-section h3{font-size:18px;margin:3px 0 5px}.guided-foundation-section p{margin:0;max-width:680px;color:#77746d;font-size:10px;line-height:1.55}.guided-foundation-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap;justify-content:flex-end}.guided-foundation-actions>span{font-size:9px;font-weight:800;background:#efeee9;padding:6px 8px;border-radius:999px}.guided-token-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0}.guided-token-list .type-token{border-radius:0;border:0;border-bottom:1px solid #efeee9}.guided-token-list .type-token:nth-child(odd){border-right:1px solid #efeee9}@media(max-width:900px){.guided-foundation-section>header{display:grid}.guided-foundation-actions{justify-content:flex-start}.guided-token-list{grid-template-columns:1fr}.guided-token-list .type-token:nth-child(odd){border-right:0}}

/* Explicit Initial / Override state for primitive values */
.token-value-wrap{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px;align-items:center;min-width:0}.token-mode{display:inline-flex;align-items:center;justify-content:center;min-width:54px;padding:5px 7px;border-radius:999px;font-size:8px;font-weight:800;line-height:1;border:1px solid #e1e0da;background:#f2f1ed;color:#6f6d66}.token-mode.override{background:#111;color:#fff;border-color:#111}.token-reset{font-size:9px;white-space:nowrap;border:1px solid #deddd7!important;background:#fff!important;border-radius:7px!important;padding:7px 9px!important;color:#5f5d57!important}.token-reset:hover{border-color:#bbb9b1!important;color:#111!important}.token-reset.is-hidden{visibility:hidden;pointer-events:none}.type-token{grid-template-columns:minmax(180px,1.15fr) minmax(220px,1fr) auto}.type-token.custom{background:#fbfaf5}.type-token.custom .token-value{border-color:#c9c6b9;background:#fff}.token-identity{min-width:0}@media(max-width:720px){.type-token{grid-template-columns:1fr}.token-value-wrap{grid-template-columns:auto 1fr}.token-reset{justify-self:start}.token-reset.is-hidden{display:none}}

/* 11H.4 — keep token state + reset usable without fighting the value field */
.type-token{
  grid-template-columns:minmax(180px,1.15fr) minmax(220px,1fr);
  gap:14px;
  align-items:center;
}
.token-control{
  min-width:0;
  display:grid;
  gap:6px;
}
.token-control .token-value{
  width:100%;
  min-width:0;
}
.token-control-meta{
  min-height:24px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}
.token-control-meta .token-mode{
  flex:0 0 auto;
}
.token-control-meta .token-reset{
  flex:0 0 auto;
  padding:4px 7px!important;
  border-radius:999px!important;
  font-size:8px;
  line-height:1;
  min-height:24px;
}
.token-reset.is-hidden{
  visibility:hidden;
  pointer-events:none;
}
@media(max-width:720px){
  .type-token{grid-template-columns:1fr}
  .token-control-meta{justify-content:flex-start}
  .token-reset.is-hidden{display:none}
}

/* Colour builder IA + polish — guided phase navigation */
.colour-guided-shell{gap:18px}
.colour-journey{display:grid;grid-template-columns:minmax(0,2.4fr) minmax(230px,.9fr) minmax(150px,.55fr);gap:10px;background:transparent}
.colour-journey>section{border:1px solid #e2e1db;border-radius:14px;background:#f8f8f5;overflow:hidden;min-width:0}
.colour-journey>section>header{display:flex;gap:10px;align-items:center;padding:10px 12px;border-bottom:1px solid #e7e6e0;background:#f2f2ee}
.colour-journey>section>header>span{font:800 9px ui-monospace,SFMono-Regular,Consolas,monospace;color:#9b9890}
.colour-journey>section>header>div{display:grid;gap:1px;min-width:0}
.colour-journey>section>header strong{font-size:10px;line-height:1.2}
.colour-journey>section>header small{font-size:8px;color:#8b8880;line-height:1.2}
.colour-journey-steps{display:grid;background:#fff}
.colour-journey-steps.primitives{grid-template-columns:repeat(6,minmax(0,1fr))}
.colour-journey-steps.semantics{grid-template-columns:repeat(2,minmax(0,1fr))}
.colour-journey-steps.finish{grid-template-columns:1fr}
.colour-journey-step{appearance:none;border:0;border-right:1px solid #ecebe6;background:#fff;padding:10px 9px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:7px;align-items:center;text-align:left;cursor:pointer;min-width:0;color:#45443f}
.colour-journey-step:last-child{border-right:0}
.colour-journey-step:hover{background:#f8f8f5}
.colour-journey-step.active{background:#171717;color:#fff}
.colour-journey-step.complete:not(.active){background:#fbfcfa}
.colour-journey-number{font:700 8px ui-monospace,SFMono-Regular,Consolas,monospace;color:#aaa79f}
.colour-journey-step.active .colour-journey-number{color:#aaa}
.colour-journey-copy{display:grid;gap:1px;min-width:0}
.colour-journey-copy strong{font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.colour-journey-copy small{font-size:7.5px;color:#97948c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.colour-journey-step.active .colour-journey-copy small{color:#bdbdbd}
.colour-journey-step.complete:not(.active) .colour-journey-copy small,.colour-journey-step.complete:not(.active) .colour-journey-state{color:#46734d}
.colour-journey-state{font-size:10px;color:#aaa79f}
.colour-palette-context{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px 12px;border:1px solid #e4e3dd;border-radius:11px;background:#fafaf8}
.colour-palette-context>span{font-size:9px;font-weight:800;color:#706e67;white-space:nowrap}
.colour-palette-context>div{height:18px;display:flex;overflow:hidden;border-radius:6px;border:1px solid #deddd7;background:#fff}
.colour-palette-context i{flex:1;min-width:6px}
.colour-palette-context small{font-size:8px;color:#8a8880;white-space:nowrap}
.colour-stage{border-radius:16px;box-shadow:0 1px 2px rgba(0,0,0,.025)}
.colour-stage-head{padding:24px 26px;background:#fbfbf9;align-items:center}
.colour-stage-heading{max-width:720px}
.colour-stage-head h3{font-size:26px;letter-spacing:-.025em;margin:5px 0 8px}
.colour-stage-head p{font-size:12.5px;line-height:1.6;color:#6d6b64}
.colour-stage-actions{justify-content:flex-end;flex-wrap:wrap}
.stage-progress{display:flex;align-items:baseline;gap:3px;padding:7px 10px;background:#efeee9}
.stage-progress b{font-size:13px;color:#222}
.stage-progress span{font-size:9px;color:#8a8880}
.colour-ai-button{white-space:nowrap}
.colour-stage-body{min-width:0}
.colour-stage-body>.source-grid{padding:20px;gap:14px}
.colour-source-card{border-radius:13px;box-shadow:0 1px 0 rgba(0,0,0,.015)}
.source-card-head{padding:14px 15px 12px}
.source-card-head span{font-size:12px}
.source-card-head small{font-size:10px;line-height:1.45}
.source-input{grid-template-columns:44px minmax(0,1fr) auto;padding:13px 14px;gap:10px}
.source-swatch{width:42px;height:42px;border-radius:10px}
.source-hex{padding:10px 11px;font-size:11px}
.source-reset{font-size:9px;padding:9px 10px}
.generated-strip{min-height:38px}
.generated-tone i{height:27px}
.generated-tone small{font-size:7.5px;padding:4px 1px}
.ground-preview{border-top:0;padding:0 20px 20px;gap:10px}
.ground-preview>div{min-height:126px;border:1px solid #e5e4de;border-radius:12px;padding:15px;overflow:hidden}
.ground-preview span{font-size:10px}.ground-preview b{font-size:9px}
.neutral-builder{padding:20px;gap:18px}.neutral-builder>.colour-source-card{max-width:none}
.neutral-scale-preview header{padding:14px 15px}.neutral-scale-preview header strong{font-size:12px}.neutral-scale-preview header span{font-size:10px;line-height:1.4;text-align:right}
.colour-review{padding:20px;gap:16px}
.palette-completion{padding:20px}.palette-completion p{font-size:11px;line-height:1.5;max-width:720px}
.review-palette-sections>section>header{padding:12px 14px}.review-palette-sections header strong{font-size:12px}.review-palette-sections header span{font-size:10px}
.review-family{grid-template-columns:150px minmax(0,1fr)}.review-family>b{font-size:10px;padding:12px 14px}.review-family .generated-tone i{height:30px}
.semantic-generation-head{padding:20px 20px 0;margin-bottom:14px}.semantic-ai-note{margin:14px 20px}.semantic-group{margin:14px 20px}.semantic-group:last-child{margin-bottom:20px}
.semantic-mapping{padding:15px 16px}.semantic-mapping b{font-size:12px}.semantic-mapping small{font-size:9px;line-height:1.35}
.colour-stage-nav{padding:13px 16px;align-items:center}
.colour-stage-nav>div{display:grid;gap:1px;text-align:center;color:#6f6d66}
.colour-stage-nav>div span{font-size:9px;font-weight:800}.colour-stage-nav>div small{font-size:8px;color:#99968e}
.colour-footer-actions{padding-top:2px}
@media(max-width:1280px){.colour-journey{grid-template-columns:1fr}.colour-journey-steps.primitives{grid-template-columns:repeat(6,minmax(100px,1fr));overflow-x:auto}.colour-journey>section{overflow-x:auto}}
@media(max-width:760px){.colour-palette-context{grid-template-columns:1fr}.colour-stage-head{align-items:flex-start;padding:20px}.colour-stage-actions{width:100%;justify-content:space-between}.colour-stage-body>.source-grid{padding:14px}.ground-preview{padding:0 14px 14px}.semantic-generation-head{padding:16px 16px 0;flex-direction:column}.semantic-ai-note,.semantic-group{margin-left:16px;margin-right:16px}.colour-stage-nav>div{display:none}.colour-journey-steps.primitives{grid-template-columns:repeat(6,112px)}}


/* Colour builder readability correction — do not compress the guided UI */
.colour-journey{grid-template-columns:minmax(0,2.2fr) minmax(300px,1fr) minmax(190px,.65fr);gap:12px}
.colour-journey>section>header{padding:13px 15px;gap:11px}
.colour-journey>section>header>span{font-size:11px}
.colour-journey>section>header strong{font-size:13px}
.colour-journey>section>header small{font-size:11px;line-height:1.35}

.colour-journey-step{padding:14px 12px;gap:9px;min-height:62px}
.colour-journey-number{font-size:10px}
.colour-journey-copy strong{font-size:12px}
.colour-journey-copy small{font-size:10px;line-height:1.3}
.colour-journey-state{font-size:13px}

.colour-palette-context{padding:13px 15px;gap:14px}
.colour-palette-context>span{font-size:11px}
.colour-palette-context>div{height:24px}
.colour-palette-context small{font-size:10px}

.colour-stage-head{padding:26px 28px}
.colour-stage-head h3{font-size:28px}
.colour-stage-head p{font-size:14px;line-height:1.6}
.stage-progress{padding:8px 11px}
.stage-progress b{font-size:15px}
.stage-progress span{font-size:11px}

.colour-stage-body>.source-grid{padding:22px;gap:16px}
.source-card-head{padding:15px 16px 13px}
.source-card-head span{font-size:14px}
.source-card-head small{font-size:12px;line-height:1.45}
.source-state{font-size:10px!important}

.source-input{grid-template-columns:48px minmax(0,1fr) auto;padding:14px 15px;gap:11px}
.source-swatch{width:46px;height:46px}
.source-hex{padding:11px 12px;font-size:13px}
.source-reset{font-size:11px;padding:9px 11px}

.generated-strip{min-height:44px}
.generated-tone i{height:31px}
.generated-tone small{font-size:9px;padding:5px 2px}

.ground-preview>div{min-height:140px;padding:17px}
.ground-preview span{font-size:12px}
.ground-preview b{font-size:11px}

.neutral-scale-preview header{padding:15px 16px}
.neutral-scale-preview header strong{font-size:14px}
.neutral-scale-preview header span{font-size:12px}

.palette-completion p{font-size:13px}
.review-palette-sections header strong{font-size:14px}
.review-palette-sections header span{font-size:11px}
.review-family>b{font-size:12px}

.semantic-mapping{padding:16px 17px}
.semantic-mapping b{font-size:13px}
.semantic-mapping small{font-size:11px;line-height:1.4}

.colour-stage-nav{padding:15px 18px}
.colour-stage-nav>div span{font-size:11px}
.colour-stage-nav>div small{font-size:10px}

@media(max-width:1280px){
  .colour-journey{grid-template-columns:1fr}
  .colour-journey-steps.primitives{grid-template-columns:repeat(6,minmax(130px,1fr))}
}
@media(max-width:760px){
  .colour-stage-head h3{font-size:24px}
  .colour-stage-head p{font-size:13px}
  .colour-journey-steps.primitives{grid-template-columns:repeat(6,140px)}
}

/* Colour semantic swatches + accessibility guidance */
.semantic-role{display:flex;align-items:center;gap:11px;min-width:0}
.semantic-role>span{min-width:0}
.semantic-role-swatch{display:block;width:34px;height:34px;flex:0 0 34px;border-radius:9px;border:1px solid rgba(127,127,127,.22);box-shadow:inset 0 0 0 1px rgba(255,255,255,.16)}
.semantic-role-swatch.empty{background:linear-gradient(135deg,rgba(127,127,127,.08) 25%,transparent 25%,transparent 75%,rgba(127,127,127,.08) 75%);background-size:10px 10px}
.semantic-choice{display:grid;gap:7px;min-width:0}
.semantic-selected-source{display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:8px;padding:7px 9px;border:1px solid var(--line,#e7e9ee);border-radius:8px;background:rgba(127,127,127,.035);font-size:10px;color:var(--muted,#667085)}
.semantic-selected-source i{width:20px;height:20px;border-radius:6px;border:1px solid rgba(127,127,127,.22)}
.semantic-selected-source span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.semantic-selected-source b{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;font-weight:600;color:inherit}
.semantic-accessibility{margin-top:2px;padding:10px 11px;border:1px solid var(--line,#e7e9ee);border-radius:9px;background:rgba(127,127,127,.025);display:grid;gap:7px}
.semantic-accessibility-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.semantic-accessibility-head strong{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted,#667085)}
.semantic-accessibility-head b{font-size:11px}
.semantic-accessibility.recommended .semantic-accessibility-head b{color:var(--success,#157347)}
.semantic-accessibility.minimum .semantic-accessibility-head b{color:var(--warning,#9a6700)}
.semantic-accessibility.fail .semantic-accessibility-head b{color:var(--danger,#b42318)}
.semantic-accessibility-thresholds{display:flex;flex-wrap:wrap;gap:6px}
.semantic-accessibility-thresholds span{padding:4px 7px;border-radius:999px;background:rgba(127,127,127,.07);font-size:10px;color:var(--muted,#667085)}
.semantic-accessibility-thresholds b{font-size:10px;color:inherit}
.semantic-accessibility>small{font-size:9.5px!important;line-height:1.4!important;color:var(--muted,#667085)}
@media(max-width:1200px){.semantic-mapping{grid-template-columns:minmax(0,1fr) minmax(260px,1fr)}}
@media(max-width:760px){.semantic-mapping{grid-template-columns:1fr}.semantic-choice,.semantic-mapping small{grid-column:1}.semantic-accessibility-head{align-items:flex-start;flex-direction:column;gap:4px}}

/* Semantic colour IA refinement: grouped families, quieter rows, useful previews */
.semantic-group{overflow:hidden}
.semantic-group>header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:16px 18px;background:#f8f8f5;border-bottom:1px solid var(--line,#e7e9ee)}
.semantic-group>header>div{display:grid;gap:3px}
.semantic-group>header strong{font-size:16px}
.semantic-group>header small{font-size:11px;line-height:1.4;color:var(--muted,#667085);font-weight:400}
.semantic-group>header>span{font-size:12px;font-weight:800;color:var(--muted,#667085)}
.semantic-subgroup-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 18px;background:#fcfcfa;border-bottom:1px solid var(--line,#e7e9ee)}
.semantic-subgroup-head strong{font-size:12px;letter-spacing:.01em}
.semantic-subgroup-head span{font-size:10px;color:var(--muted,#667085)}
.semantic-mapping-list{grid-template-columns:repeat(2,minmax(0,1fr))}
.semantic-mapping{grid-template-columns:minmax(170px,.85fr) minmax(250px,1.15fr);min-height:106px;padding:18px;gap:14px 18px;background:#fff}
.semantic-mapping.fixed{background:#fbfbf9}
.semantic-role{align-self:start}
.semantic-role-swatch{width:44px;height:44px;flex-basis:44px;border-radius:11px}
.semantic-role b{font-size:14px;line-height:1.25}
.semantic-role code{display:none}
.semantic-fixed-label{display:inline-flex;margin-top:5px;padding:3px 6px;border-radius:999px;background:#efeee9;color:#77746d;font-size:9px!important;font-weight:700}
.semantic-choice{gap:9px}
.semantic-choice-control{display:grid;grid-template-columns:minmax(0,1fr);gap:8px}
.semantic-choice-control select{min-height:40px;font-size:12px}
.semantic-source-chip,.semantic-fixed-source{display:grid;grid-template-columns:26px minmax(0,1fr) auto;align-items:center;gap:9px;padding:9px 10px;border:1px solid var(--line,#e7e9ee);border-radius:9px;background:#fff;min-width:0}
.semantic-source-chip i,.semantic-fixed-source>i{width:26px;height:26px;border-radius:7px;border:1px solid rgba(127,127,127,.22)}
.semantic-source-chip span,.semantic-fixed-source span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;color:var(--muted,#667085)}
.semantic-source-chip b{font:600 10px ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted,#667085)}
.semantic-fixed-source{grid-template-columns:26px minmax(0,1fr) auto;background:#f8f8f5}
.semantic-fixed-source span{display:grid;gap:2px}
.semantic-fixed-source span b{font-size:11px;color:#44433e;overflow:hidden;text-overflow:ellipsis}
.semantic-fixed-source span small{font:500 9px ui-monospace,SFMono-Regular,Consolas,monospace;color:#88857e}
.semantic-fixed-source em{font-style:normal;font-size:9px;font-weight:800;padding:4px 7px;border-radius:999px;background:#eae9e4;color:#66645e}
.semantic-accessibility{grid-template-columns:88px minmax(0,1fr);align-items:stretch;padding:0;overflow:hidden;gap:0;background:#fff}
.semantic-contrast-preview{display:grid;place-items:center;align-content:center;gap:2px;min-height:76px;padding:9px;border-right:1px solid var(--line,#e7e9ee);text-align:center}
.semantic-contrast-preview b{font-size:24px;line-height:1}
.semantic-contrast-preview span{font-size:8px;opacity:.75;max-width:72px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.semantic-accessibility-copy{display:grid;gap:7px;padding:10px 11px}
.semantic-accessibility-head strong{font-size:9px}
.semantic-accessibility-head b{font-size:11px}
.semantic-accessibility-thresholds{gap:5px}
.semantic-accessibility-thresholds span{font-size:9.5px;padding:4px 6px}
.semantic-accessibility>small{display:none}
@media(max-width:1200px){.semantic-mapping-list{grid-template-columns:1fr}.semantic-mapping:nth-child(odd){border-right:0}}
@media(max-width:760px){.semantic-mapping{grid-template-columns:1fr}.semantic-accessibility{grid-template-columns:74px minmax(0,1fr)}}

/* Semantic colour assignment layout — compact, visual, non-spreadsheet */
.semantic-mapping-list{grid-template-columns:repeat(2,minmax(0,1fr))}
.semantic-mapping{grid-template-columns:minmax(150px,1fr) minmax(180px,220px);min-height:92px;padding:16px 18px;gap:14px;align-items:center}
.semantic-role{display:flex;align-items:center;gap:12px;min-width:0}
.semantic-role-swatch{width:48px;height:48px;flex:0 0 48px;border-radius:12px}
.semantic-role>span{min-width:0}
.semantic-role b{font-size:14px;line-height:1.25}
.semantic-choice{display:grid;gap:8px;min-width:0;width:100%;max-width:220px;justify-self:end}
.semantic-choice-control{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;min-width:0}
.semantic-choice-control select{width:100%;min-width:0;min-height:38px;padding:7px 30px 7px 9px;font-size:11px;border-radius:8px}
.semantic-source-value{display:flex;align-items:center;gap:6px;min-height:38px;padding:6px 8px;border:1px solid var(--line,#e7e9ee);border-radius:8px;background:#fff;white-space:nowrap}
.semantic-source-value i{width:22px;height:22px;flex:0 0 22px;border-radius:6px;border:1px solid rgba(127,127,127,.22)}
.semantic-source-value b{font:600 9px ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--muted,#667085)}
.semantic-fixed-source{width:100%;grid-template-columns:24px minmax(0,1fr) auto;padding:7px 8px;border-radius:8px}
.semantic-fixed-source>i{width:24px;height:24px}
.semantic-fixed-source span b{font-size:10.5px}
.semantic-fixed-source span small{font-size:8.5px}
.semantic-fixed-source em{font-size:8.5px;padding:3px 6px}
.semantic-fixed-label{display:none}
.semantic-accessibility{max-width:220px}
@media(max-width:1350px){
  .semantic-mapping-list{grid-template-columns:1fr}
  .semantic-mapping:nth-child(odd){border-right:0}
  .semantic-mapping{grid-template-columns:minmax(190px,1fr) minmax(240px,300px)}
  .semantic-choice{max-width:300px}
  .semantic-accessibility{max-width:300px}
}
@media(max-width:760px){
  .semantic-mapping{grid-template-columns:1fr;align-items:start}
  .semantic-choice{max-width:none;justify-self:stretch}
  .semantic-choice-control{grid-template-columns:minmax(0,1fr) auto}
  .semantic-accessibility{max-width:none}
}


/* Semantic accessibility status — explicit pass/fail feedback */
.semantic-role>span{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.semantic-a11y-badge{display:inline-flex;align-items:center;min-height:22px;padding:3px 7px;border-radius:999px;font-size:9px;font-weight:800;line-height:1;letter-spacing:.045em;border:1px solid currentColor;white-space:nowrap}
.semantic-a11y-badge.recommended{color:#157347;background:#edf8f1}
.semantic-a11y-badge.minimum{color:#8a5a00;background:#fff7df}
.semantic-a11y-badge.fail{color:#b42318;background:#fff0ee}
.semantic-a11y-badge.pending{color:#667085;background:#f4f5f7}
.semantic-accessibility.recommended{border-color:#b7dfc4;background:#f7fcf8}
.semantic-accessibility.minimum{border-color:#ead18a;background:#fffaf0}
.semantic-accessibility.fail{border-color:#efb4ad;background:#fff7f6}
.semantic-accessibility.pending{border-color:#d5d9e0;background:#fafbfc}
.semantic-accessibility-head strong{font-size:10px!important;font-weight:850;letter-spacing:.06em}
.semantic-accessibility.recommended .semantic-accessibility-head strong{color:#157347}
.semantic-accessibility.minimum .semantic-accessibility-head strong{color:#8a5a00}
.semantic-accessibility.fail .semantic-accessibility-head strong{color:#b42318}
.semantic-accessibility.pending .semantic-accessibility-head strong{color:#667085}


/* Semantic accessibility summary */
.semantic-a11y-summary{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:12px 15px;border:1px solid var(--line);border-radius:12px;background:#fafbfc}
.semantic-a11y-summary>span{display:flex;flex-direction:column;gap:2px;margin-right:auto}
.semantic-a11y-summary>span b{font-size:12px}
.semantic-a11y-summary>span small,.semantic-a11y-fixed-note{font-size:10px;color:var(--muted)}
.semantic-a11y-summary.has-fail{border-color:#efb4ad;background:#fff8f7}
.semantic-a11y-summary.has-fail>span b{color:#b42318}
.semantic-a11y-summary.all-pass{border-color:#b7dfc4;background:#f7fcf8}
.semantic-a11y-summary.all-pass>span b{color:#157347}


/* Semantic role contract disclosure */
.semantic-rules{margin-top:7px;border-top:1px solid var(--line);padding-top:7px}
.semantic-rules summary{cursor:pointer;font-size:10px;font-weight:750;color:var(--muted);list-style:none}
.semantic-rules summary::-webkit-details-marker{display:none}
.semantic-rules summary::after{content:' +';font-weight:800}
.semantic-rules[open] summary::after{content:' −'}
.semantic-rules-grid{display:grid;gap:6px;margin-top:8px}
.semantic-rules-grid>div{display:grid;grid-template-columns:88px minmax(0,1fr);gap:8px;align-items:start}
.semantic-rules-grid b{font-size:9px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.semantic-rules-grid span{font-size:10px;line-height:1.4}

/* Colour consolidation — guided Palette → Meaning → Light → Dark → Review */
.colour-flow-nav{display:grid;gap:10px;padding:0;margin-bottom:14px}
.colour-flow-primary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.colour-flow-phase,.colour-flow-subnav button,.semantic-chapter-tabs button{appearance:none;border:1px solid var(--line);background:var(--panel,#fff);border-radius:11px;padding:11px 12px;text-align:left;display:grid;gap:3px;cursor:pointer;color:inherit}
.colour-flow-phase span,.colour-flow-subnav span,.semantic-chapter-tabs span{font-size:9px;font-weight:800;letter-spacing:.08em;color:var(--muted)}
.colour-flow-phase b,.colour-flow-subnav b,.semantic-chapter-tabs b{font-size:12px}
.colour-flow-phase small,.colour-flow-subnav small,.semantic-chapter-tabs small{font-size:10px;color:var(--muted)}
.colour-flow-phase.active,.colour-flow-subnav button.active,.semantic-chapter-tabs button.active{border-color:currentColor;box-shadow:0 0 0 1px currentColor inset;background:var(--panel,#fff)}
.colour-flow-phase.complete span,.colour-flow-subnav button.complete span{font-weight:900}
.colour-flow-subnav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px;padding:9px;border:1px solid var(--line);border-radius:12px;background:rgba(0,0,0,.018)}

.meaning-stage{display:grid;gap:16px}
.meaning-map{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--panel,#fff)}
.meaning-map>header{padding:18px 20px;border-bottom:1px solid var(--line)}
.meaning-map>header h3{margin:3px 0 0}
.meaning-map>div{display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}
.meaning-map article{padding:16px;border-right:1px solid var(--line);display:grid;gap:6px;min-height:110px}
.meaning-map article:last-child{border-right:0}
.meaning-map article span{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:800}
.meaning-map article b{font-size:13px}
.meaning-map article small{font-size:11px;line-height:1.4;color:var(--muted)}
.meaning-map>p{margin:0;padding:14px 20px;border-top:1px solid var(--line);font-size:12px;line-height:1.5;color:var(--muted)}
.meaning-palette-review{border:1px solid var(--line);border-radius:12px;background:var(--panel,#fff);overflow:hidden}
.meaning-palette-review>summary{cursor:pointer;padding:14px 16px;font-weight:750}
.meaning-palette-review>.review-palette-sections{padding:0 14px 14px}

.guided-semantic-workspace{display:grid;gap:14px}
.semantic-chapter-tabs{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px;overflow-x:auto}
.semantic-chapter-tabs button{min-width:112px}
.semantic-visual-review{border:1px solid var(--line);border-radius:14px;background:var(--panel,#fff);overflow:hidden}
.semantic-visual-review>header{padding:17px 18px;border-bottom:1px solid var(--line)}
.semantic-visual-review>header h3{margin:2px 0 4px;font-size:20px}
.semantic-visual-review>header p{margin:0;color:var(--muted);font-size:12px}
.semantic-family-lanes{display:grid}
.semantic-family-lanes>article{padding:14px 16px;border-bottom:1px solid var(--line);display:grid;gap:10px}
.semantic-family-lanes>article:last-child{border-bottom:0}
.semantic-family-lanes>article>header strong{font-size:12px}
.semantic-family-strip{display:flex;gap:8px;overflow-x:auto;padding-bottom:2px}
.semantic-family-chip{flex:1 0 118px;max-width:180px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:rgba(0,0,0,.012)}
.semantic-family-chip>i{display:block;height:52px;background:transparent}
.semantic-family-chip>span{display:grid;gap:3px;padding:9px}
.semantic-family-chip b{font-size:11px}
.semantic-family-chip small{font-size:9px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.semantic-family-chip em{justify-self:start;font-style:normal;font-size:8px;font-weight:850;padding:3px 5px;border-radius:999px;border:1px solid currentColor}
.semantic-family-chip em.recommended{color:#157347;background:#edf8f1}.semantic-family-chip em.minimum{color:#8a5a00;background:#fff7df}.semantic-family-chip em.fail{color:#b42318;background:#fff0ee}.semantic-family-chip em.pending{color:#667085;background:#f4f5f7}
.semantic-quality-clear{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:11px 14px;border:1px solid #b7dfc4;border-radius:11px;background:#f7fcf8}
.semantic-quality-clear b{font-size:11px;color:#157347}.semantic-quality-clear span{font-size:10px;color:var(--muted)}
.semantic-quality-findings{border:1px solid #ead18a;border-radius:11px;background:#fffaf0;overflow:hidden}
.semantic-quality-findings>header{padding:10px 13px;border-bottom:1px solid #ead18a}.semantic-quality-findings>header b{font-size:11px;color:#8a5a00}
.semantic-quality-findings article{display:grid;gap:3px;padding:10px 13px;border-bottom:1px solid #f0dfad}.semantic-quality-findings article:last-child{border-bottom:0}.semantic-quality-findings strong{font-size:11px}.semantic-quality-findings span{font-size:10px;line-height:1.4;color:var(--muted)}
.semantic-technical{border:1px solid var(--line);border-radius:12px;background:var(--panel,#fff);overflow:hidden}
.semantic-technical>summary{cursor:pointer;padding:13px 15px;display:flex;justify-content:space-between;gap:12px;align-items:center}
.semantic-technical>summary span{font-weight:750;font-size:12px}.semantic-technical>summary small{color:var(--muted);font-size:10px}
.semantic-technical>.semantic-group{border:0;border-top:1px solid var(--line);border-radius:0}

@media(max-width:1100px){.colour-flow-primary{grid-template-columns:repeat(5,minmax(120px,1fr));overflow-x:auto}.colour-flow-subnav{grid-template-columns:repeat(5,minmax(120px,1fr));overflow-x:auto}.meaning-map>div{grid-template-columns:1fr 1fr}.meaning-map article{border-bottom:1px solid var(--line)}.semantic-chapter-tabs{grid-template-columns:repeat(7,minmax(120px,1fr))}}
@media(max-width:700px){.meaning-map>div{grid-template-columns:1fr}.meaning-map article{border-right:0}.semantic-quality-clear{align-items:flex-start;flex-direction:column}}


/* Studio feedback system — replaces native browser alert / confirm / prompt */
.studio-dialog-backdrop{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;padding:24px;background:rgba(17,17,17,.42);backdrop-filter:blur(5px);opacity:0;visibility:hidden;transition:opacity .16s ease,visibility .16s ease}
.studio-dialog-backdrop.open{opacity:1;visibility:visible}
.studio-dialog{position:relative;width:min(520px,calc(100vw - 32px));overflow:hidden;border:1px solid rgba(22,22,20,.12);border-radius:18px;background:#fff;box-shadow:0 28px 80px rgba(18,18,16,.22),0 4px 16px rgba(18,18,16,.09);display:grid;grid-template-columns:44px minmax(0,1fr);gap:0;padding:24px 24px 0;transform:translateY(8px) scale(.985);transition:transform .16s ease}
.studio-dialog-backdrop.open .studio-dialog{transform:translateY(0) scale(1)}
.studio-dialog-icon{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-size:17px;font-weight:850;background:#f1f1ed;color:#4b4b46}
.studio-dialog[data-tone="danger"] .studio-dialog-icon{background:#fff0ee;color:#b42318}
.studio-dialog[data-tone="warning"] .studio-dialog-icon{background:#fff7df;color:#8a5a00}
.studio-dialog[data-tone="info"] .studio-dialog-icon{background:#eef4ff;color:#3159a6}
.studio-dialog-copy{padding:0 0 20px 14px;min-width:0}
.studio-dialog-eyebrow{display:block;margin:1px 0 6px;font-size:9px;font-weight:850;text-transform:uppercase;letter-spacing:.11em;color:#92928a}
.studio-dialog-copy h2{margin:0 34px 7px 0;font-size:20px;line-height:1.2;letter-spacing:-.02em;color:#171717}
.studio-dialog-copy>p{margin:0;color:#55554f;font-size:13px;line-height:1.55;white-space:pre-wrap}
.studio-dialog-detail{margin-top:13px;padding:11px 12px;border:1px solid #e5e4df;border-radius:10px;background:#f8f8f5;color:#66645e;font-size:11px;line-height:1.5;white-space:pre-wrap}
.studio-dialog-field{display:grid;gap:6px;margin-top:15px}
.studio-dialog-field>span{font-size:10px;font-weight:750;color:#65645e}
.studio-dialog-field input{width:100%;border:1px solid #cecdc6;border-radius:9px;padding:10px 11px;background:#fff;font:inherit;font-size:12px;outline:none}
.studio-dialog-field input:focus{border-color:#77766f;box-shadow:0 0 0 3px rgba(23,23,23,.07)}
.studio-dialog-close{position:absolute;right:14px;top:13px;width:30px;height:30px;padding:0;border:0;border-radius:8px;background:transparent;color:#82827b;font-size:20px;font-weight:400;line-height:1}
.studio-dialog-close:hover{background:#f2f2ee;color:#171717}
.studio-dialog-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:8px;margin:0 -24px;padding:13px 24px;border-top:1px solid #ecebe6;background:#fafaf7}
.studio-dialog-actions button{min-width:88px}
.studio-dialog[data-tone="danger"] .studio-dialog-actions .primary{background:#a72d25;border-color:#a72d25}
.studio-toast-region{position:fixed;z-index:10020;right:22px;bottom:22px;width:min(360px,calc(100vw - 32px));display:grid;gap:8px;pointer-events:none}
.studio-toast{pointer-events:auto;display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:10px;align-items:start;padding:12px 12px 12px 11px;border:1px solid #deddd7;border-radius:12px;background:#fff;box-shadow:0 12px 36px rgba(20,20,18,.13);opacity:0;transform:translateY(7px);transition:opacity .16s ease,transform .16s ease}
.studio-toast.show{opacity:1;transform:translateY(0)}
.studio-toast-mark{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;background:#edf8f1;color:#157347;font-weight:850}
.studio-toast.warning .studio-toast-mark{background:#fff7df;color:#8a5a00}
.studio-toast.info .studio-toast-mark{background:#eef4ff;color:#3159a6}
.studio-toast b{display:block;margin:1px 0 2px;font-size:11px}
.studio-toast p{margin:0;font-size:10px;line-height:1.45;color:#66645e}
.studio-toast button{border:0;background:transparent;padding:1px 3px;color:#92928a;font-size:16px}
@media(max-width:560px){.studio-dialog{grid-template-columns:36px minmax(0,1fr);padding:19px 18px 0}.studio-dialog-icon{width:32px;height:32px}.studio-dialog-copy{padding-left:10px}.studio-dialog-actions{margin:0 -18px;padding:12px 18px}.studio-dialog-actions button{flex:1}.studio-toast-region{right:16px;bottom:16px}}

/* Colour final review — issue-first rather than token-first */
.colour-review-mode-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.colour-review-mode{display:grid;gap:5px}
.colour-review-mode>div{display:flex;flex-wrap:wrap;gap:6px;margin-top:5px}
.colour-review-mode em{font-style:normal;font-size:9px;padding:4px 7px;border-radius:999px;background:#f2f2ee;color:#68675f}
.colour-review-mode.clear em:first-child{background:#edf8f1;color:#157347}
.colour-review-mode.attention{border-color:#ead18a;background:#fffaf0}
.colour-review-attention{overflow:hidden;border:1px solid #ead18a;border-radius:14px;background:#fffdf7}
.colour-review-attention>header{padding:17px 18px;border-bottom:1px solid #eee5c7}
.colour-review-attention h3{margin:3px 0 4px;font-size:18px}
.colour-review-attention p{margin:0;color:var(--muted);font-size:11px;line-height:1.5}
.colour-review-hard-issues{display:flex;flex-wrap:wrap;gap:8px;padding:12px 18px 0}
.colour-review-hard-issues button{border:1px solid #efb4ad;border-radius:9px;padding:8px 10px;background:#fff7f6;color:#a72d25;font-size:10px;font-weight:750}
.colour-review-attention .semantic-quality-findings{padding:12px 18px 18px}
@media(max-width:760px){.colour-review-mode-grid{grid-template-columns:1fr}}


/* Scoped Colour reset controls */
.colour-set-reset,.semantic-mode-reset{white-space:nowrap}
.colour-footer-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.colour-footer-actions .danger-subtle{margin-left:auto;border:1px solid #efb4ad;background:#fff8f7;color:#b42318;border-radius:9px;padding:9px 12px;font:inherit;font-size:11px;font-weight:700;cursor:pointer}
.colour-footer-actions .danger-subtle:hover{background:#fff0ee}
.semantic-generation-actions .ghost{min-height:34px}
@media(max-width:900px){
  .colour-footer-actions .danger-subtle{margin-left:0}
}


/* Semantic build provenance */
.semantic-build-provenance{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 13px;border:1px solid var(--line);border-radius:10px;background:#fafbfc}
.semantic-build-provenance strong{font-size:11px}
.semantic-build-provenance span{font-size:10px;color:var(--muted)}
.semantic-build-provenance.ai{border-color:#b7dfc4;background:#f7fcf8}
.semantic-build-provenance.ai strong{color:#157347}
.semantic-build-provenance.deterministic{border-color:#d8dde6;background:#fafbfc}
.semantic-build-provenance.building{border-color:#c8d8ff;background:#f7f9ff}
.semantic-build-provenance.error{border-color:#efb4ad;background:#fff8f7}
.semantic-build-provenance.error strong{color:#b42318}


/* Semantic workspace layout repair
   Keep explanation, controls and provenance as separate horizontal bands.
   Never allow the toolbar to squeeze the explanatory copy into a narrow column. */
.guided-semantic-workspace{
  display:grid;
  gap:14px;
  min-width:0;
}

.guided-semantic-workspace .semantic-generation-head{
  display:grid;
  grid-template-columns:minmax(0,1fr);
  gap:14px;
  align-items:start;
  padding:20px;
  margin:0;
  border:1px solid var(--line);
  border-radius:14px;
  background:var(--panel,#fff);
}

.guided-semantic-workspace .semantic-generation-head>div:first-child{
  min-width:0;
  max-width:780px;
}

.guided-semantic-workspace .semantic-generation-head h3{
  margin:4px 0 6px;
  font-size:20px;
  line-height:1.15;
}

.guided-semantic-workspace .semantic-generation-head p{
  margin:0;
  max-width:760px;
  font-size:12px;
  line-height:1.5;
  color:var(--muted,#667085);
}

.guided-semantic-workspace .semantic-generation-actions{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  white-space:normal;
  width:100%;
  padding-top:12px;
  border-top:1px solid var(--line);
}

.guided-semantic-workspace .semantic-generation-actions>span{
  display:inline-flex;
  align-items:center;
  min-height:34px;
  padding:0 10px;
  border-radius:999px;
  background:#f1f1ed;
  font-size:11px;
  font-weight:800;
  margin-right:auto;
}

.guided-semantic-workspace .semantic-generation-actions button{
  min-height:34px;
  white-space:nowrap;
}

.guided-semantic-workspace .semantic-build-provenance{
  width:100%;
  box-sizing:border-box;
  margin:0;
}

.guided-semantic-workspace>.semantic-a11y-summary{
  margin:0;
}

/* Chapters should form a readable set, not an off-screen horizontal strip. */
.guided-semantic-workspace .semantic-chapter-tabs{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(108px,1fr));
  gap:7px;
  overflow:visible;
  min-width:0;
}

.guided-semantic-workspace .semantic-chapter-tabs button{
  min-width:0;
}

/* Visual hierarchy is the main review surface. Keep every family visible. */
.guided-semantic-workspace .semantic-visual-review{
  min-width:0;
}

.guided-semantic-workspace .semantic-family-strip{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(125px,1fr));
  gap:8px;
  overflow:visible;
  min-width:0;
}

.guided-semantic-workspace .semantic-family-chip{
  min-width:0;
  max-width:none;
  width:100%;
}

.guided-semantic-workspace .semantic-family-chip>span{
  min-width:0;
}

.guided-semantic-workspace .semantic-family-chip small{
  min-width:0;
  max-width:100%;
}

/* Findings should read like review notes rather than another horizontal control strip. */
.guided-semantic-workspace .semantic-quality-findings{
  min-width:0;
}

/* The technical editor is deliberately secondary. */
.guided-semantic-workspace .semantic-technical{
  margin-top:0;
}

@media(max-width:900px){
  .guided-semantic-workspace .semantic-generation-head{
    padding:16px;
  }

  .guided-semantic-workspace .semantic-generation-actions{
    align-items:stretch;
  }

  .guided-semantic-workspace .semantic-generation-actions>span{
    width:100%;
    margin-right:0;
    justify-content:flex-start;
  }

  .guided-semantic-workspace .semantic-generation-actions button{
    flex:1 1 160px;
  }

  .guided-semantic-workspace .semantic-chapter-tabs{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .guided-semantic-workspace .semantic-family-strip{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}

@media(max-width:560px){
  .guided-semantic-workspace .semantic-chapter-tabs,
  .guided-semantic-workspace .semantic-family-strip{
    grid-template-columns:1fr;
  }
}


/* Colour Palette import / export */
.palette-io-actions{
  display:inline-flex;
  align-items:center;
  gap:6px;
}
.palette-io-actions .ghost{
  white-space:nowrap;
}
@media(max-width:900px){
  .palette-io-actions{
    width:100%;
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}


/* Studio-only Colour Review export */
.colour-review-completion-actions{
  display:flex;
  align-items:center;
  gap:12px;
  flex:0 0 auto;
}
.colour-review-completion-actions strong{
  min-width:44px;
  text-align:center;
}
@media(max-width:760px){
  .colour-review-completion{
    align-items:flex-start;
  }
  .colour-review-completion-actions{
    width:100%;
    justify-content:space-between;
  }
}


/* Studio-only AI build audit */
.colour-ai-audit-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:14px;
}
.colour-ai-audit-grid:empty{display:none}
.colour-ai-audit-card{
  border:1px solid var(--line);
  border-radius:14px;
  padding:16px;
  background:var(--panel);
  min-width:0;
}
.colour-ai-audit-card header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16px;
}
.colour-ai-audit-card header h4{
  margin:3px 0 0;
  font-size:15px;
}
.colour-ai-audit-card header>strong{
  font-size:20px;
  white-space:nowrap;
}
.colour-ai-audit-card>p{
  margin:10px 0 14px;
  max-width:62ch;
}
.colour-ai-audit-stats{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:8px;
}
.colour-ai-audit-stats span,
.colour-ai-audit-choices span{
  display:flex;
  flex-direction:column;
  gap:2px;
  padding:9px 10px;
  border:1px solid var(--line);
  border-radius:10px;
  min-width:0;
}
.colour-ai-audit-stats b{font-size:14px}
.colour-ai-audit-stats small{font-size:11px}
.colour-ai-audit-choices{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:8px;
  margin-top:8px;
}
.colour-ai-audit-choices span{
  flex-direction:row;
  align-items:center;
  justify-content:space-between;
}
.colour-ai-audit-card details{margin-top:12px}
.colour-ai-audit-card summary{cursor:pointer;font-weight:600}
.colour-ai-audit-families{
  display:grid;
  gap:7px;
  margin-top:10px;
}
.colour-ai-audit-families>div{
  display:grid;
  grid-template-columns:minmax(140px,1fr) auto;
  gap:3px 12px;
  padding:9px 0;
  border-top:1px solid var(--line);
}
.colour-ai-audit-families small{
  grid-column:1/-1;
  line-height:1.45;
}
@media(max-width:980px){
  .colour-ai-audit-grid{grid-template-columns:1fr}
}
@media(max-width:620px){
  .colour-ai-audit-stats{grid-template-columns:repeat(2,minmax(0,1fr))}
}


/* BufferCore Studio feedback system */
.studio-dialog-backdrop{
  position:fixed;
  inset:0;
  z-index:10000;
  display:grid;
  place-items:center;
  padding:24px;
  background:rgba(8,10,18,.58);
  backdrop-filter:blur(8px);
}
.studio-dialog{
  width:min(460px,100%);
  overflow:hidden;
  border:1px solid var(--border,rgba(255,255,255,.12));
  border-radius:16px;
  background:var(--surface,#151822);
  box-shadow:0 24px 72px rgba(0,0,0,.38);
}
.studio-dialog>header{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:18px 18px 0;
}
.studio-dialog>header h3{margin:2px 0 0}
.studio-dialog-mark{
  width:9px;
  height:9px;
  margin-top:7px;
  flex:0 0 auto;
  border-radius:999px;
  background:var(--accent,#7c6cff);
}
.studio-dialog--error .studio-dialog-mark,
.studio-dialog--danger .studio-dialog-mark{background:#e05b67}
.studio-dialog-body{padding:14px 18px 18px}
.studio-dialog-body p{margin:0;white-space:pre-wrap}
.studio-dialog-input{display:grid;gap:6px;margin-top:14px}
.studio-dialog-input input{width:100%}
.studio-dialog>footer{
  display:flex;
  justify-content:flex-end;
  gap:8px;
  padding:12px 18px 18px;
}
.studio-toast-host{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:10020;
  display:grid;
  gap:8px;
  pointer-events:none;
}
.studio-toast{
  max-width:min(360px,calc(100vw - 36px));
  padding:10px 12px;
  border:1px solid var(--border,rgba(255,255,255,.12));
  border-radius:10px;
  background:var(--surface,#151822);
  box-shadow:0 12px 34px rgba(0,0,0,.28);
  opacity:0;
  transform:translateY(6px);
  transition:opacity .18s ease,transform .18s ease;
}
.studio-toast.is-visible{opacity:1;transform:translateY(0)}
.studio-toast--error{border-color:rgba(224,91,103,.5)}
@media (prefers-reduced-motion:reduce){
  .studio-toast{transition:none}
}
